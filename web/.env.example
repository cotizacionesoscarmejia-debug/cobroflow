# Copia este archivo a .env.local y pon ahí tus valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore) — cada quien lo llena a mano.

# ── Supabase — Project Settings → API Keys (pestaña "API Keys", no "Legacy") ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_URL=https://xxxx.supabase.co                      # la misma URL, lado servidor
SUPABASE_SECRET_KEY=sb_secret_xxxx                          # SOLO servidor — jamás en el navegador

# ── Stripe (se agrega más adelante en esta misma sesión) ────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Resend — emails transaccionales (se agrega más adelante) ────────────────
# RESEND_API_KEY=
# EMAIL_FROM=hola@tudominio.com

# ── IA (Premium — "Analizar mi negocio") ─────────────────────────────────────
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_DAILY_BUDGET_USD=20
