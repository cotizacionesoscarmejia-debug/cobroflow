# Copia este archivo a .env.local y pon ahí tus valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore) — cada quien lo llena a mano.

# ── Supabase — Project Settings → API Keys (pestaña "API Keys", no "Legacy") ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx   # pública por diseño (RLS la protege)
SUPABASE_URL=https://xxxx.supabase.co                      # la misma URL, lado servidor
SUPABASE_SECRET_KEY=sb_secret_xxxx                          # SOLO servidor — jamás en el navegador

# ── Hotmart — cobro de Pro/Premium (Stripe no cubre Guatemala, se cambió a
#    Hotmart en Sesión 6). Un solo producto de Hotmart con 2 planes/ofertas
#    adentro. El HOTTOK sale de Hotmart → Herramientas → Webhook → pestaña
#    Autenticación. HOTMART_PRODUCT_ID es el ID del producto "CobroFlow"; los
#    OFFER_CODE son el parámetro `off=` del link de pago de cada plan ─────────
# HOTMART_HOTTOK=
# HOTMART_PRODUCT_ID=8326549
# HOTMART_OFFER_CODE_PRO=s6j82uzz
# HOTMART_OFFER_CODE_PREMIUM=avoatd7z

# ── Resend — sistema de emails (Sesión 6, "más adelante" ya llegó). Un solo
#    RESEND_API_KEY sirve para los dos remitentes (tx./news. — la separación
#    real vive en el DOMINIO verificado en Resend, no en la key). ───────────
# RESEND_API_KEY=

# ── Cron de emails (Vercel Cron llama /api/cron/emails una vez al día) — el
#    valor de CRON_SECRET debe copiarse TAL CUAL en el header que Vercel manda
#    solo; no hace falta configurarlo en Vercel aparte de la env var. ───────
# CRON_SECRET=

# ── IA (Premium — "Analizar mi negocio") ─────────────────────────────────────
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5
# AI_DAILY_BUDGET_USD=20
